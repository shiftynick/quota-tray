<Window x:Class="QuotaTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quota Tray"
        Width="410"
        MinWidth="410"
        SizeToContent="Height"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding AlwaysOnTop}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
        </Style>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="#242832" />
            <Setter Property="BorderBrush" Value="#343A46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303641" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProviderRefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Refresh this provider" />
        </Style>
        <Style x:Key="ProviderCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <DataTemplate x:Key="QuotaWindowTemplate">
            <StackPanel Margin="0,5,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding RemainingLabel}"
                               FontWeight="Bold"
                               FontSize="12.5"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
                <ProgressBar Height="5"
                             Margin="0,4,0,0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding RemainingPercent}"
                             Foreground="{Binding Accent}"
                             Background="#30343D"
                             BorderThickness="0" />
                <TextBlock Text="{Binding ResetLabel}"
                           Visibility="{Binding ResetVisibility}"
                           Style="{StaticResource SecondaryTextStyle}"
                           FontSize="10.5"
                           Margin="0,3,0,0" />
                <Border Visibility="{Binding PacingVisibility}"
                        Background="#20242C"
                        CornerRadius="6"
                        Padding="8,5"
                        Margin="0,5,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding PaceLabel}"
                                   Foreground="{Binding PaceBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="10.5" />
                        <TextBlock Text="{Binding AverageLabel}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   FontSize="10.5" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="8"
            Background="{StaticResource WindowBackground}"
            BorderBrush="#3A404C"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="4"
                              Opacity="0.5"
                              Color="#000000" />
        </Border.Effect>
        <ScrollViewer x:Name="ContentScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Padding="0,0,2,0">
            <Grid Margin="14,10,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderArea"
                      Background="Transparent"
                      MouseLeftButtonDown="HeaderArea_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="28"
                           Height="28"
                           Source="Assets/quota-tray.ico"
                           Margin="0,0,9,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Quota Tray"
                                   FontSize="16"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding LastUpdatedText}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   FontSize="10.5"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                    <Button x:Name="RefreshButton"
                            Grid.Column="2"
                            Content="↻"
                            ToolTip="Refresh quotas"
                            AutomationProperties.Name="Refresh quotas"
                            Style="{StaticResource HeaderButtonStyle}"
                            Click="RefreshButton_Click" />
                    <Button Grid.Column="3"
                            Content="×"
                            ToolTip="Hide to tray"
                            AutomationProperties.Name="Hide to tray"
                            Style="{StaticResource HeaderButtonStyle}"
                            Click="CloseButton_Click" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,10,0,8">
                    <Border Style="{StaticResource ProviderCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{StaticResource ClaudeAccent}"
                                             Margin="0,3,8,0" />
                                    <TextBlock Text="Claude"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Claude.PlanLabel}"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Button Content="{Binding Claude.RefreshGlyph}"
                                            IsEnabled="{Binding Claude.CanRefresh}"
                                            Style="{StaticResource ProviderRefreshButtonStyle}"
                                            Tag="Claude"
                                            ToolTip="Refresh Claude"
                                            AutomationProperties.Name="Refresh Claude"
                                            Click="ProviderRefreshButton_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Visibility="{Binding Claude.StatusVisibility}"
                                    Background="{Binding Claude.StatusBackground}"
                                    CornerRadius="6"
                                    Padding="8,5"
                                    Margin="0,6,0,1">
                                <TextBlock Text="{Binding Claude.StatusMessage}"
                                           Foreground="{Binding Claude.StatusForeground}"
                                           FontWeight="SemiBold"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Claude.Windows}"
                                          ItemTemplate="{StaticResource QuotaWindowTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ProviderCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{StaticResource CodexAccent}"
                                             Margin="0,3,8,0" />
                                    <TextBlock Text="Codex"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Codex.PlanLabel}"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Button Content="{Binding Codex.RefreshGlyph}"
                                            IsEnabled="{Binding Codex.CanRefresh}"
                                            Style="{StaticResource ProviderRefreshButtonStyle}"
                                            Tag="Codex"
                                            ToolTip="Refresh Codex"
                                            AutomationProperties.Name="Refresh Codex"
                                            Click="ProviderRefreshButton_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Visibility="{Binding Codex.StatusVisibility}"
                                    Background="{Binding Codex.StatusBackground}"
                                    CornerRadius="6"
                                    Padding="8,5"
                                    Margin="0,6,0,1">
                                <TextBlock Text="{Binding Codex.StatusMessage}"
                                           Foreground="{Binding Codex.StatusForeground}"
                                           FontWeight="SemiBold"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Codex.Windows}"
                                          ItemTemplate="{StaticResource QuotaWindowTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ProviderCardStyle}"
                            Margin="0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{StaticResource CursorAccent}"
                                             Margin="0,3,8,0" />
                                    <TextBlock Text="Cursor"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Cursor.PlanLabel}"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Button Content="{Binding Cursor.RefreshGlyph}"
                                            IsEnabled="{Binding Cursor.CanRefresh}"
                                            Style="{StaticResource ProviderRefreshButtonStyle}"
                                            Tag="Cursor"
                                            ToolTip="Refresh Cursor"
                                            AutomationProperties.Name="Refresh Cursor"
                                            Click="ProviderRefreshButton_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Visibility="{Binding Cursor.StatusVisibility}"
                                    Background="{Binding Cursor.StatusBackground}"
                                    CornerRadius="6"
                                    Padding="8,5"
                                    Margin="0,6,0,1">
                                <TextBlock Text="{Binding Cursor.StatusMessage}"
                                           Foreground="{Binding Cursor.StatusForeground}"
                                           FontWeight="SemiBold"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Cursor.Windows}"
                                          ItemTemplate="{StaticResource QuotaWindowTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <CheckBox Content="Pacing"
                              IsChecked="{Binding ShowPacingInsights, Mode=TwoWay}"
                              Foreground="{StaticResource SecondaryText}"
                              ToolTip="Show locally calculated weekly pacing and daily budget estimates"
                              VerticalAlignment="Center"
                              FontSize="11" />
                    <CheckBox Content="Always on top"
                              IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                              Foreground="{StaticResource SecondaryText}"
                              ToolTip="Keep the quota window above other windows"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Margin="14,0,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>

<Window x:Class="QuotaTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quota Tray"
        Width="430"
        MinWidth="430"
        SizeToContent="Height"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding AlwaysOnTop}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
        </Style>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="#242832" />
            <Setter Property="BorderBrush" Value="#343A46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303641" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="QuotaWindowTemplate">
            <StackPanel Margin="0,8,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding RemainingLabel}"
                               FontWeight="Bold"
                               Margin="12,0,0,0" />
                </Grid>
                <ProgressBar Height="7"
                             Margin="0,7,0,4"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding RemainingPercent}"
                             Foreground="{Binding Accent}"
                             Background="#30343D"
                             BorderThickness="0" />
                <TextBlock Text="{Binding ResetLabel}"
                           Style="{StaticResource SecondaryTextStyle}"
                           FontSize="11" />
                <Border Visibility="{Binding PacingVisibility}"
                        Background="#20242C"
                        CornerRadius="7"
                        Padding="9,7"
                        Margin="0,7,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding PaceLabel}"
                                   Foreground="{Binding PaceBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                        <TextBlock Text="{Binding AverageLabel}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   FontSize="11" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="10"
            Background="{StaticResource WindowBackground}"
            BorderBrush="#3A404C"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="4"
                              Opacity="0.5"
                              Color="#000000" />
        </Border.Effect>
        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderArea"
                  Background="Transparent"
                  MouseLeftButtonDown="HeaderArea_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="34"
                       Height="34"
                       Source="Assets/quota-tray.ico"
                       Margin="0,0,11,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Quota Tray"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding LastUpdatedText}"
                               Style="{StaticResource SecondaryTextStyle}"
                               FontSize="11"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="RefreshButton"
                        Grid.Column="2"
                        Content="↻"
                        ToolTip="Refresh quotas"
                        AutomationProperties.Name="Refresh quotas"
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="RefreshButton_Click" />
                <Button Grid.Column="3"
                        Content="×"
                        ToolTip="Hide to tray"
                        AutomationProperties.Name="Hide to tray"
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="CloseButton_Click" />
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="0,16,0,12">
                    <Border Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="15"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10"
                                             Height="10"
                                             Fill="{StaticResource ClaudeAccent}"
                                             Margin="0,2,9,0" />
                                    <TextBlock Text="Claude"
                                               FontSize="17"
                                               FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Claude.PlanLabel}"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </Grid>
                            <TextBlock Text="{Binding Claude.StatusMessage}"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0" />
                            <ItemsControl ItemsSource="{Binding Claude.Windows}"
                                          ItemTemplate="{StaticResource QuotaWindowTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="15">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10"
                                             Height="10"
                                             Fill="{StaticResource CodexAccent}"
                                             Margin="0,2,9,0" />
                                    <TextBlock Text="Codex"
                                               FontSize="17"
                                               FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Codex.PlanLabel}"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </Grid>
                            <TextBlock Text="{Binding Codex.StatusMessage}"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0" />
                            <ItemsControl ItemsSource="{Binding Codex.Windows}"
                                          ItemTemplate="{StaticResource QuotaWindowTemplate}" />
                        </StackPanel>
                    </Border>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Left-click the tray icon to show or hide."
                           Style="{StaticResource SecondaryTextStyle}"
                           HorizontalAlignment="Center"
                           FontSize="11" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,9,0,0">
                    <CheckBox Content="Pacing &amp; daily budget"
                              IsChecked="{Binding ShowPacingInsights, Mode=TwoWay}"
                              Foreground="{StaticResource SecondaryText}"
                              ToolTip="Show locally calculated weekly pacing and daily budget estimates"
                              VerticalAlignment="Center" />
                    <CheckBox Content="Always on top"
                              IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                              Foreground="{StaticResource SecondaryText}"
                              ToolTip="Keep the quota window above other windows"
                              VerticalAlignment="Center"
                              Margin="18,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
